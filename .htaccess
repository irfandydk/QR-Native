# QR-SAR - Root Apache Security & Routing Configuration
# Kantor Pencarian dan Pertolongan (KPP) Kelas A Kendari - Basarnas
Options -Indexes

# 1. Block access to hidden, environment, database dumps, and configuration files
<FilesMatch "^\.(env|git|gitignore|htaccess)|(\.sql|\.sqlite|\.log|\.md|\.sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Block direct HTTP access to core application folders (root & subfolder deployments)
RedirectMatch 403 (?i)(?:^|/)(database|config|models|controllers|services|helpers|views|storage|tests|cli|scratch)(?:/|$)

# 3. Clean URLs & Front Controller Routing (Supports /operasi, /admin, /gis, /api, etc.)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Do not rewrite if physical file or directory exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route clean URLs through router.php
    RewriteRule ^ router.php [L,QSA]
</IfModule>

# 4. Standard Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Batas unggahan (mod_php): foto dokumen RENOPS maks 5 MB per berkas, hingga 12 foto
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 128M
    php_value memory_limit 512M
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 128M
    php_value memory_limit 512M
    php_value max_file_uploads 30
</IfModule>
