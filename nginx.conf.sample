# ==============================================================================
# QR-SAR - Production Nginx Server Block Configuration Guide
# Kantor Pencarian dan Pertolongan (KPP) Kelas A Kendari - Basarnas
# Arsitektur PHP Native Modern dengan Dual-Mode Deployment (Public / Root Docroot)
# ==============================================================================

server {
    listen 80;
    server_name qrsar.basarnas.go.id;

    # OPSI A (SANGAT DIREKOMENDASIKAN): Document Root mengarah langsung ke folder /public
    # Direktori privat (config, models, controllers, services, helpers, views, database)
    # berada 100% di luar DocRoot web server.
    root /var/www/html/QR-SAR/public;
    index index.php index.html;

    # Charset
    charset utf-8;

    # Log Files
    access_log /var/log/nginx/qrsar_access.log;
    error_log /var/log/nginx/qrsar_error.log;

    # Security: Disable logging for favicon and robots.txt
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Front Controller Routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM FastCGI Configuration
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    # Keamanan Direktori Uploads (Cegah Eksekusi Skrip PHP & skrip SVG pada File Unggahan)
    location ^~ /uploads/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox" always;
        location ~* \.php$ {
            deny all;
            return 403;
        }
    }

    # Proteksi Berkas Tersembunyi (.env, .git, .htaccess)
    location ~ /\.(?!well-known).* {
        deny all;
        return 403;
    }

    # Optimasi Caching untuk Asset Statis (CSS, JS, Fonts, Images)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
