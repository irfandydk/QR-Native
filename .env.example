# QR-SAR - Environment Configuration Template
# Kantor Pencarian dan Pertolongan (KPP) Kelas A Kendari - Basarnas

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
# Kosongkan APP_URL agar host & subfolder (mis. http://localhost/QR-SAR di Laragon) terdeteksi otomatis
APP_URL=
# Opsional (disarankan di produksi): daftar host/port yang diizinkan, dipisahkan koma.
# Kosong = terima host yang lolos validasi sintaks; jika diisi, Host tidak terdaftar diarahkan ke entri pertama.
# Contoh: ALLOWED_HOSTS=app.qrsar.my.id,192.168.100.58:8085,192.168.100.58:8080
ALLOWED_HOSTS=

# Secret Cryptographic Key (HMAC-SHA256 for QR verification and tokens)
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qrsar
DB_USERNAME=root
DB_PASSWORD=

# Gemini AI Assistant API Key
GEMINI_API_KEY=

# Optional Google Maps Keys
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
