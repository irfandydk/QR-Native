# QR-SAR - Environment Configuration Template
# Kantor Pencarian dan Pertolongan (KPP) Kelas A Kendari - Basarnas

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Secret Cryptographic Key (HMAC-SHA256 for QR verification and tokens)
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qrsar
DB_USERNAME=root
DB_PASSWORD=

# Gemini AI Assistant API Key
GEMINI_API_KEY=

# Optional Google Maps Keys
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
